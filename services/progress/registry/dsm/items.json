 "items": [
  {
   "id": "MDE.A",
   "disorder": "MDE",
   "criterion": "A",
   "label": "Depressive symptom count",
   "paraphrase": "Five or more A-items within the same two-week period, a change from usual; one must be A1 or A2.",
   "chapter": "Depressive Disorders",
   "kind": "stem",
   "model_assessed": true,
   "satisfied_by": null,
   "notes": "",
   "verification": {
    "status": "pending",
    "verified_by": null,
    "verified_on": null,
    "comment": ""
   }
  },
  {
   "id": "MDE.A1",
   "disorder": "MDE",
   "criterion": "A1",
   "label": "Depressed mood",
   "paraphrase": "Low, sad, empty or hopeless mood most of the day, nearly every day, reported or observed.",
   "chapter": "Depressive Disorders",
   "kind": "symptom",
   "model_assessed": true,
   "satisfied_by": {
    "feature": "feat.depressed_mood"
   },
   "notes": "",
   "verification": {
    "status": "pending",
    "verified_by": null,
    "verified_on": null,
    "comment": ""
   }
  },
  {
   "id": "MDE.A2",
   "disorder": "MDE",
   "criterion": "A2",
   "label": "Loss of interest or pleasure",
   "paraphrase": "Much less interest or pleasure in all or almost all activities, most days.",
   "chapter": "Depressive Disorders",
   "kind": "symptom",
   "model_assessed": true,
   "satisfied_by": {
    "feature": "feat.anhedonia"
   },
   "notes": "Not satisfied when the person simply lacks the opportunity; the interest itself must be reduced.",
   "verification": {
    "status": "pending",
    "verified_by": null,
    "verified_on": null,
    "comment": ""
   }
  },
  {
   "id": "MDE.A3",
   "disorder": "MDE",
   "criterion": "A3",
   "label": "Appetite or weight change",
   "paraphrase": "Clear weight loss without dieting, weight gain, or appetite clearly lower or higher nearly every day.",
   "chapter": "Depressive Disorders",
   "kind": "symptom",
   "model_assessed": true,
   "satisfied_by": {
    "feature": "feat.appetite_weight"
   },
   "notes": "",
   "verification": {
    "status": "pending",
    "verified_by": null,
    "verified_on": null,
    "comment": ""
   }
  },
  {
   "id": "MDE.A4",
   "disorder": "MDE",
   "criterion": "A4",
   "label": "Insomnia or hypersomnia",
   "paraphrase": "Sleeping too little (insomnia) or too much (hypersomnia) nearly every day.",
   "chapter": "Depressive Disorders",
   "kind": "symptom",
   "model_assessed": true,
   "satisfied_by": {
    "feature": "feat.sleep_insomnia_hypersomnia"
   },
   "notes": "Short sleep with tiredness counts here; short sleep without tiredness during a high period is MANIA.B2.",
   "verification": {
    "status": "pending",
    "verified_by": null,
    "verified_on": null,
    "comment": ""
   }
  },
  {
   "id": "MDE.A5",
   "disorder": "MDE",
   "criterion": "A5",
   "label": "Psychomotor slowing or agitation",
   "paraphrase": "Slowed or agitated movement nearly every day that others can see, not only felt.",
   "chapter": "Depressive Disorders",
   "kind": "symptom",
   "model_assessed": true,
   "satisfied_by": {
    "feature": "feat.psychomotor_observable"
   },
   "notes": "Needs an observable change; a private feeling of restlessness is not enough.",
   "verification": {
    "status": "pending",
    "verified_by": null,
    "verified_on": null,
    "comment": ""
   }
  },
  {
