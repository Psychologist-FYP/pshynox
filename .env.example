# Copy to .env, then run uvicorn with --env-file .env (see README.md).
# Run commands from the repository root so these relative paths resolve correctly.
APP_ENV=development
FIXTURE_MODE=false
DATABASE_URL=sqlite:///./data/pshynox.db
LOCAL_DATA_DIR=./data
SPEECH_WORKER_ENABLED=true
WHISPER_BINARY=./data/tools/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=./models/ggml-base.bin
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4
WHISPER_TIMEOUT_SECONDS=1800
