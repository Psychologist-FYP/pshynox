# scripts/run.py creates .env from this file automatically when missing.
# The launcher runs from the repository root so these relative paths resolve correctly.
APP_ENV=development
FIXTURE_MODE=false
DATABASE_URL=sqlite:///./data/pshynox.db
LOCAL_DATA_DIR=./data
# Separate research datasets, annotations, immutable exports and benchmark runs.
RESEARCH_DATA_DIR=./data/research
SPEECH_WORKER_ENABLED=true
WHISPER_BINARY=./data/tools/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=./models/ggml-base.bin
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4
WHISPER_TIMEOUT_SECONDS=1800

# Local Module B evidence search. Alternatives: fixture, tfidf, e5, hybrid.
RETRIEVAL_METHOD=bm25
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
RETRIEVAL_CONTEXT_TURNS=1
RETRIEVAL_CACHE_SESSIONS=8
# Optional method-specific abstention threshold; tune only on development data.
# RETRIEVAL_MIN_SCORE=0.8
RETRIEVAL_E5_MODEL=intfloat/multilingual-e5-small
# Pin a Hugging Face commit hash for reproducible dense evaluation.
RETRIEVAL_E5_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RETRIEVAL_E5_CACHE_DIR=./models/retrieval
RETRIEVAL_E5_LOCAL_ONLY=true

# Optional manual LAN meeting setup; scripts/run_lan.py sets the origin automatically.
# MEETING_PUBLIC_ORIGIN=https://192.168.1.20:5173
# Direct Wi-Fi connections use no hosted ICE service by default.
MEETING_ICE_SERVERS=[]

# Local notes: exact native-template/tokenizer accounting, unchanged 4096 context.
NOTE_CONTEXT=4096
NOTE_OVERVIEW_OUTPUT=800
NOTE_OVERVIEW_MAX_OUTPUT=1600
NOTE_SAFETY_MARGIN=64
NOTE_MAX_SPLIT_DEPTH=8
NOTE_MAX_GENERATION_CALLS=96
NOTE_MIN_SPAN_CHARS=64
NOTE_OVERVIEW_MAX_TURNS=16

# off = quiet; events = progress/counts; full = complete prompts/responses and drafts.
NOTE_LOG_LEVEL=events

# Grouped drafting retains Qwen/context; sections selects the legacy diagnostic baseline.
NOTE_DRAFT_STRATEGY=auto
NOTE_DRAFT_OUTPUT=1600
NOTE_DRAFT_MAX_OUTPUT=2304

# Local LLM runtime (llama.cpp llama-server + Qwen3-4B GGUF). scripts/setup.sh writes these with absolute paths.
# Without them the app looks for models/llama.cpp/build/bin/llama-server and runs on the CPU.
# NOTE_LLAMA_SERVER=/absolute/path/to/llama-server
# NOTE_LIBRARY_PATH=/absolute/dir/of/llama-server:/absolute/dir/of/cuda-runtime-libs
# NOTE_GPU_LAYERS=0          # 99 offloads every layer to an NVIDIA GPU
# NOTE_BATCH_SIZE=256
# NOTE_UBATCH_SIZE=128
# NOTE_QWEN_MODEL=/absolute/path/to/Qwen3-4B-Instruct-2507-Q4_K_M.gguf   # default: models/note_generation/qwen/

# Progress monitoring Stage A prompt (v2 default; v1 reproduces the earlier prompt).
# PROGRESS_EXTRACT_PROMPT=v2

# Internet meetings (scripts/run_internet.py). lan keeps the same-Wi-Fi behaviour of scripts/run_lan.py.
# MEETING_MODE=internet
# MEETING_PUBLIC_ORIGIN=https://your-laptop.your-tailnet.ts.net
# MEETING_PUBLIC_PORT=8443
# TURN relay for internet meetings. Keys stay here (server side); browsers receive short-lived credentials only.
# TURN_PROVIDER=cloudflare
# CLOUDFLARE_TURN_KEY_ID=<your-turn-key-id>
# CLOUDFLARE_TURN_API_TOKEN=<your-turn-api-token>
# CLOUDFLARE_TURN_TTL_SECONDS=14400
# Optional secondary provider (off by default):
# TURN_PROVIDER=metered
# METERED_APP_SUBDOMAIN=<your-subdomain>
# METERED_API_KEY=<your-metered-api-key>
